{
  "name": "@bellx2/upnote-mcp",
  "version": "0.2.5",
  "description": "Unofficial read-only MCP server for reading local UpNote data.",
  "type": "module",
  "module": "src/index.ts",
  "bin": {
    "upnote-mcp": "src/index.ts"
  },
  "files": [
    "src",
    "README.md",
    "README_ja.md",
    "CLAUDE.md",
    "LICENSE"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bellx2/upnote-mcp.git"
  },
  "homepage": "https://github.com/bellx2/upnote-mcp#readme",
  "bugs": {
    "url": "https://github.com/bellx2/upnote-mcp/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "check": "tsc --noEmit",
    "smoke": "bun run scripts/smoke.ts",
    "prepublishOnly": "bun run check"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  }
}
